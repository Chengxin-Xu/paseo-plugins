{
  "name": "paseo-project-notes",
  "private": true,
  "version": "0.10.3",
  "description": "Project Notes (拾页) for Paseo: tasks, prompts and ideas per project, a launcher that starts an agent from a note, and a CLI for agents",
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ui": "playwright test --config tests/playwright.config.mjs",
    "preview:build": "node scripts/preview.mjs",
    "preview:shots": "node scripts/shots.mjs",
    "build": "esbuild server/cli.ts --bundle --platform=node --target=node22 --format=esm --outfile=bin/notes.mjs --banner:js=\"#!/usr/bin/env node\" --log-level=warning"
  },
  "dependencies": {
    "esbuild": "^0.28.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@getpaseo/client": "0.11.1",
    "@getpaseo/plugin": "0.11.1",
    "@getpaseo/protocol": "0.11.1",
    "@playwright/test": "^1.63.0",
    "@tanstack/react-query": "^5.90.11",
    "@types/node": "^22.20.3",
    "@types/react": "~19.2.0",
    "@types/react-test-renderer": "19.1.0",
    "lucide-react": "1.47.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-web": "^0.21.2",
    "react-test-renderer": "19.1.0",
    "typescript": "^5.9.3",
    "vitest": "4.1.11"
  },
  "overrides": {
    "vite": "7.3.6"
  }
}
