{
  "name": "paseo-terracotta-themes",
  "private": true,
  "type": "module",
  "version": "0.6.0",
  "description": "Twelve color themes for Paseo, six dark and six light, derived from one perceptual tonal ladder, plus a live custom theme tuned with sliders",
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types --import ./tests/support/register.mjs tests/*.test.ts",
    "preview": "node --experimental-strip-types scripts/preview.mjs",
    "generate": "node --experimental-strip-types scripts/generate-themes.mjs"
  },
  "devDependencies": {
    "@getpaseo/plugin": "0.11.0",
    "@types/node": "^22.20.3",
    "@types/react": "~19.2.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.6"
  }
}
